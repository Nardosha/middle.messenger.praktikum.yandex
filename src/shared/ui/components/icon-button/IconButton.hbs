{{#if isActive}}
  <button class='icon-button {{buttonClass}} icon-button_state_active'>
    {{#if text}}
      <p class='icon-button__text'>{{text}}</p>
    {{/if}}

    {{#if src}}
      <img
        src='/assets/icons/{{src}}.svg'
        alt='{{iconAlt}}'
        class='icon-button__icon'
      />
    {{/if}}
  </button>

{{else}}
  <button class='icon-button {{buttonClass}}'>
    {{#if text}}
      <p class='icon-button__text'>{{text}}</p>
    {{/if}}

  {{#if src}}
    <img
      src='/assets/icons/{{src}}.svg'
      alt='{{iconAlt}}'
      class='icon-button__icon'
    />
  </button>
  {{/if}}
{{/if}}